# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 커밋되지 않습니다)

# OpenRouter API 키 (https://openrouter.ai/keys) - 필수
OPENROUTER_API_KEY=

# AI 모델명 (OpenRouter 모델 ID) - 이미지 인식과 레시피 생성에 함께 사용
AI_MODEL=nvidia/nemotron-3.5-super-vl:free
# (선택) 이미지 인식 / 텍스트 생성 모델만 따로 바꿀 때
VISION_MODEL=
TEXT_MODEL=

# (선택) 서버 포트, 모델 응답 제한 시간(ms)
PORT=8080
OPENROUTER_TIMEOUT_MS=90000
RECIPE_TIMEOUT_MS=120000
# (선택) 모델 내부 추론 off(기본, 빠름) / on(느리지만 더 신중함)
OPENROUTER_REASONING=off

# 로그인 세션 쿠키 서명 키 (32자 이상) - Docker/운영에서는 필수
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# (선택) 로그인 유지 기간(일)
SESSION_TTL_DAYS=7

# (선택) 레시피 저장소: file(기본, ./data/recipes.json) 또는 cosmos
STORAGE_DRIVER=file
DATA_DIR=./data
# cosmos일 때. 운영(ACA)은 관리 ID로 접속하므로 COSMOS_KEY를 두지 않는다
COSMOS_ENDPOINT=
COSMOS_DATABASE=fridge-chef
COSMOS_CONTAINER=recipes
COSMOS_USERS_CONTAINER=users
COSMOS_KEY=

# (선택) Google Gemini - 앱에서는 쓰지 않고 example.js에서만 사용
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# 비우면 gemini-3.8-flash 사용
GEMINI_MODEL=
