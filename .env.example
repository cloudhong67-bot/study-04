# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 커밋되지 않습니다)

# 앱이 쓰는 AI: gemini(기본) 또는 openrouter. 고른 쪽의 키만 필수다.
AI_PROVIDER=gemini

# Google Gemini API 키 (https://aistudio.google.com/apikey) - AI_PROVIDER=gemini일 때 필수
GEMINI_API_KEY=
# (GEMINI_API_KEY가 없으면 이 이름도 읽는다)
GOOGLE_GENERATIVE_AI_API_KEY=
# 비우면 gemini-3.5-flash-lite (가장 빠름). gemini-3.8-flash는 응답이 매우 느렸다.
GEMINI_MODEL=

# OpenRouter API 키 (https://openrouter.ai/keys) - AI_PROVIDER=openrouter일 때 필수
OPENROUTER_API_KEY=
# 비우면 nvidia/nemotron-3.5-super-vl:free (예전 이름 AI_MODEL도 읽는다)
OPENROUTER_MODEL=

# (선택) 이미지 인식 / 텍스트 생성 모델만 따로 바꿀 때 (고른 제공자의 모델 ID)
VISION_MODEL=
TEXT_MODEL=

# (선택) 서버 포트, 모델 응답 제한 시간(ms)
PORT=8080
AI_TIMEOUT_MS=90000
RECIPE_TIMEOUT_MS=120000
# (선택) 모델 내부 추론 off(기본, 가장 적게·빠름) / on(모델 기본값, 느림)
# Gemini는 off일 때 reasoning_effort=minimal을 보낸다. minimal을 지원하지 않는 모델(gemini-3.8-flash 등)은 on으로 둔다.
AI_REASONING=off

# 로그인 세션 쿠키 서명 키 (32자 이상) - Docker/운영에서는 필수
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# (선택) 로그인 유지 기간(일)
SESSION_TTL_DAYS=7

# (선택) 레시피 저장소: file(기본, ./data/recipes.json) 또는 cosmos
STORAGE_DRIVER=file
DATA_DIR=./data
# cosmos일 때. 운영(ACA)은 관리 ID로 접속하므로 COSMOS_KEY를 두지 않는다
COSMOS_ENDPOINT=
COSMOS_DATABASE=fridge-chef
COSMOS_CONTAINER=recipes
COSMOS_USERS_CONTAINER=users
COSMOS_KEY=
