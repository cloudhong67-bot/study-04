# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 커밋되지 않습니다)

# OpenRouter API 키 (https://openrouter.ai/keys) - 필수
OPENROUTER_API_KEY=

# AI 모델명 (OpenRouter 모델 ID) - 이미지 인식과 레시피 생성에 함께 사용
AI_MODEL=nvidia/nemotron-3.5-super-vl:free
# (선택) 이미지 인식 / 텍스트 생성 모델만 따로 바꿀 때
VISION_MODEL=
TEXT_MODEL=

# (선택) 서버 포트, 모델 응답 제한 시간(ms)
PORT=8080
OPENROUTER_TIMEOUT_MS=90000

# (선택) Google Gemini - 앱에서는 쓰지 않고 example.js에서만 사용
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# 비우면 gemini-3.8-flash 사용
GEMINI_MODEL=
